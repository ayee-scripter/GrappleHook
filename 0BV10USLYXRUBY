-- 1. Tap GH Button: Equips Grapple Hook (Asset 30393548)
button.MouseButton1Click:Connect(function()
    pcall(function()
        local objects = game:GetObjects("rbxassetid://30393548")
        if objects and #objects > 0 then
            local gear = objects[1]
            gear.Parent = player:WaitForChild("Backpack")
            
            if player.Character and player.Character:FindFirstChildOfClass("Humanoid") then
                player.Character.Humanoid:EquipTool(gear)
            end
        end
    end)
end)

-- 2. Tap Anywhere to Grapple
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if isGrappling then return end

        local location = input.Position
        local unitRay = camera:ScreenPointToRay(location.X, location.Y)
        
        local raycastParams = RaycastParams.new()
        if player.Character then
            raycastParams.FilterDescendantsInstances = {player.Character}
            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        end

        local raycastResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * 2000, raycastParams)

        if raycastResult then
            grappleTo(raycastResult.Position)
        end
    end
end)
