---------------------------------------------------------
-- Grapple & Rope Mechanics
---------------------------------------------------------
local isGrappling = false

local function createRope(startPart, targetPosition)
    local attachmentStart = Instance.new("Attachment")
    attachmentStart.Parent = startPart

    local endPart = Instance.new("Part")
    endPart.Size = Vector3.new(0.1, 0.1, 0.1)
    endPart.Position = targetPosition
    endPart.Anchored = true
    endPart.Transparency = 1
    endPart.CanCollide = false
    endPart.Parent = workspace

    local attachmentEnd = Instance.new("Attachment")
    attachmentEnd.Parent = endPart

    -- Thick Black String
    local beam = Instance.new("Beam")
    beam.Texture = ""
    beam.Color = ColorSequence.new(Color3.fromRGB(0, 0, 0))
    beam.Width0 = 0.5
    beam.Width1 = 0.5
    beam.FaceCamera = true
    beam.Attachment0 = attachmentStart
    beam.Attachment1 = attachmentEnd
    beam.Parent = workspace

    return beam, endPart, attachmentStart
end

local function grappleTo(targetPosition)
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local rootPart = character.HumanoidRootPart
    isGrappling = true

    -- Create black rope
    local beam, endPart, attachmentStart = createRope(rootPart, targetPosition)

    -- Move character to target location
    local distance = (targetPosition - rootPart.Position).Magnitude
    local travelTime = math.clamp(distance / 130, 0.15, 1.0)

    local tweenInfo = TweenInfo.new(travelTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = CFrame.new(targetPosition + Vector3.new(0, 3, 0))})
    
    tween:Play()

    -- Cleanup after teleportation ends
    tween.Completed:Connect(function()
        if beam then beam:Destroy() end
        if endPart then endPart:Destroy() end
        if attachmentStart then attachmentStart:Destroy() end
        isGrappling = false
    end)
end

